# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID администратора, которому приходят брони (узнать: @userinfobot).
# Админ должен один раз нажать /start у бота, иначе Telegram не даст боту ему написать.
ADMIN_ID=
